{
  "schemaVersion": 1,
  "id": "astralostinai",
  "version": "${version}",
  "name": "AstraLostInAI",
  "description": "Local AI bridge for Minecraft survival",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "org.wwgs.astralostinai.client.AstralostinaiDataGenerator"
    ],
    "client": [
      "org.wwgs.astralostinai.client.AstralostinaiClient"
    ],
    "main": [
      "org.wwgs.astralostinai.Astralostinai"
    ]
  },
  "mixins": [
    "astralostinai.mixins.json",
    {
      "config": "astralostinai.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "java": ">=21",
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
